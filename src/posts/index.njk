<meta name="author" content="Ed Galvez">
<link rel="canonical" href="https://edgardomunoznajar.github.io/posts/">
<meta name="robots" content="index, follow">
<link rel="alternate" type="application/atom+xml" title="Ed Galvez — writing" href="/feed.xml">

<meta property="og:type" content="website">
<meta property="og:url" content="https://edgardomunoznajar.github.io/posts/">
<meta property="og:title" content="Writing - Ed Galvez">
<meta property="og:description" content="Notes on measuring AI-attributed commits on public GitHub.">
<meta property="og:site_name" content="Ed Galvez">
<meta name="twitter:card" content="summary">

<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="container">

<header>
  <h1>Writing</h1>
  <p>Notes on running agents under governance, and on the commit data — what moved, and what the instrument can and cannot see.</p>
  <a class="backlink" href="../">&larr; back to ed galvez</a>
</header>

<ul class="posts">
{%- for post in collections.post | reverse %}
  <li>
    <h2><a href="{{ post.page.fileSlug }}.html">{{ post.data.title }}</a></h2>
    <time datetime="{{ post.page.date | isoDate }}">{{ post.page.date | textDate }}</time>
    <p>{{ post.data.summary }}</p>
  </li>
{%- endfor %}
</ul>

{#- The collection key only exists once a first post does, so the empty
    state has to test absence as well as emptiness. -#}
{%- if (not collections.post) or collections.post.length == 0 %}
<div class="empty">
  Nothing published yet.
</div>
{%- endif %}

<footer>
  <a href="../">Ed Galvez</a> &middot; <a href="https://github.com/edgardomunoznajar">GitHub</a>
</footer>

</div>
</body>
</html>
